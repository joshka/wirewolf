{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Wirewolf",
  "identifier": "net.joshka.wirewolf",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "See what's wrong with your network",
    "longDescription": "Network diagnostics in a native window: where the path breaks, how bad, since when.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
